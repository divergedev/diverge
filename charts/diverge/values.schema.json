{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer" },
    "image": { "type": "object" },
    "routingProvider": {
      "type": "string",
      "enum": ["gateway", "istio"]
    },
    "resources": { "type": "object" },
    "metrics": { "type": "object" },
    "observability": { "type": "object" },
    "grafana": { "type": "object" },
    "prometheus": { "type": "object" },
    "webhook": { "type": "object" },
    "deploy": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["argocd", "direct", "noop"]
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["noop", "shared", "schema"]
        }
      }
    },
    "serviceAccount": { "type": "object" },
    "podDisruptionBudget": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "proxy": { "type": "object" },
    "activatorProxy": { "type": "object" },
    "server": { "type": "object" },
    "certManager": { "type": "object" },
    "rbac": {
      "type": "object",
      "properties": {
        "namespaceScoped": { "type": "boolean" },
        "managedNamespaces": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "if": {
        "properties": { "namespaceScoped": { "const": true } },
        "required": ["namespaceScoped"]
      },
      "then": {
        "properties": {
          "managedNamespaces": { "minItems": 1 }
        },
        "required": ["managedNamespaces"]
      }
    }
  },
  "required": ["replicaCount", "image", "routingProvider", "deploy", "database"]
}
