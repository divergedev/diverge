# EditorConfig: https://editorconfig.org
# Editors (VS Code, IntelliJ, vim, neovim) apply these rules in real-time.
# editorconfig-checker enforces them in lefthook and CI.

root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[*.proto]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_size = 2

[*.nix]
indent_size = 2
