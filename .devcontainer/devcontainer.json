{
  "name": "Diverge Preview Environment & Development",
  "image": "mcr.microsoft.com/devcontainers/go:1-1.24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "none"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [8080, 8088, 9090],
  "portsAttributes": {
    "8080": {
      "label": "Diverge Web Dashboard & API",
      "onAutoForward": "notify"
    },
    "8088": {
      "label": "Diverge L7 Proxy & DevToolbar",
      "onAutoForward": "silent"
    },
    "9090": {
      "label": "Controller Metrics",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "go build -o /usr/local/bin/diverge ./cmd/diverge && diverge version",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "redhat.vscode-yaml",
        "ms-kubernetes-tools.vscode-kubernetes-tools"
      ]
    }
  }
}
